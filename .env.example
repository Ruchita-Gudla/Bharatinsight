# ============================================================================
# BharatInsight — environment template
# Copy this file to `.env` and replace the placeholder values.
# NEVER commit the real `.env` — it is already in .gitignore.
# ============================================================================

# Full SQLAlchemy connection string used by scripts/load_data.py,
# the Phase 3 notebooks, and the Phase 5 Streamlit app.
# Use host `localhost` when running scripts/apps on your own machine.
# (Inside the Docker network, the host is the service name `postgres`.)
DATABASE_URL=postgresql://postgres:Ruchita@localhost:5432/bharatinsight_db

# PostgreSQL service settings consumed by docker-compose.yml.
# POSTGRES_PASSWORD should match the password embedded in DATABASE_URL above.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=bharatinsight_db
POSTGRES_PORT=5432

# App config (used from Phase 5 onward)
STREAMLIT_PORT=8501
ENVIRONMENT=development
